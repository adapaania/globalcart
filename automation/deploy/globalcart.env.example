# Copy to /etc/globalcart/env and replace placeholder values on the server.
# Do not commit the populated file.
ROUTELLM_API_KEY=replace_me
ROUTELLM_BASE=https://routellm.abacus.ai/v1
LLM_MODEL=replace_me
GLOBALCART_BASE=https://globalcart-production.up.railway.app
TICKETFLOW_BASE_URL=replace_me
TICKETFLOW_API_TOKEN=replace_me

# Runtime state belongs outside the application code directory.
SQLITE_DB=/opt/globalcart/data/created_tickets.db
RESOLVER_DB=/opt/globalcart/data/resolved_tickets.db
LOG_FILE=/opt/globalcart/logs/ticket_audit.log
