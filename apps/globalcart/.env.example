# GlobalCart app environment template
# Copy to .env and adjust as needed.

# ---- Backend ----
# SQLAlchemy database URL (defaults to local SQLite file)
DATABASE_URL=sqlite:///./globalcart.db
# Port the FastAPI/uvicorn server listens on
BACKEND_PORT=8000

# ---- Frontend ----
# Where the Vite dev server proxies /api requests (used inside Docker)
VITE_API_TARGET=http://localhost:8000
# Port the Vite dev server listens on
FRONTEND_PORT=5173
