# TicketFlow backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# Static Bearer token used to authenticate all endpoints (except /health).
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TICKETFLOW_API_TOKEN=changeme-generate-a-strong-token

# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./ticketflow.db

# Port the app binds to (Railway/Render inject PORT automatically).
PORT=8001
